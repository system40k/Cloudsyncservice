CLOUDSYNC_ENVIRONMENT=development
CLOUDSYNC_DATABASE_URL=postgresql+psycopg://cloudsync:cloudsync@localhost:5432/cloudsync
CLOUDSYNC_APP_SECRET=replace-with-a-random-secret-of-at-least-24-characters
CLOUDSYNC_COGNITO_ISSUER=
CLOUDSYNC_COGNITO_CLIENT_ID=
CLOUDSYNC_COGNITO_CLIENT_SECRET=
CLOUDSYNC_COGNITO_AUTHORIZE_URL=
CLOUDSYNC_COGNITO_TOKEN_URL=
CLOUDSYNC_COGNITO_LOGOUT_URL=
CLOUDSYNC_APP_BASE_URL=http://localhost:8001
CLOUDSYNC_ALLOWED_WEB_ORIGINS='["http://localhost:8001"]'
CLOUDSYNC_SESSION_COOKIE_NAME=cloudsync_session
CLOUDSYNC_SESSION_COOKIE_SECURE=false
CLOUDSYNC_SESSION_TTL_SECONDS=28800
CLOUDSYNC_MAX_FILE_BYTES=104857600
